NEXT_PUBLIC_SITE_URL=https://7tool.ru
SQLITE_PATH=
CATALOG_JSON_PATH=
CATALOG_META_PATH=
CATALOG_PUBLISH_DIR=/var/www/7tool-shared
# Set only for a storefront process that loads the shared JSON snapshot at startup.
CATALOG_RELOAD_PM2_APP_NAME=

# Supplier feed. Keep the authenticated URL only in the runtime secret store.
FEED_URL=
FEED_FILE=
FEED_MIN_OFFERS=5000
FEED_STATE_PATH=
FEED_LOCK_PATH=
FEED_PROVENANCE_ENABLED=0
FEED_SOURCE_ID=supplier-k2tool
FEED_FETCH_ATTEMPTS=2
FEED_FETCH_TIMEOUT_MS=90000
FEED_MAX_BYTES=67108864
# Emergency-only. Keep disabled so a network failure cannot make an old local XML look fresh.
FEED_ALLOW_LOCAL_FALLBACK=0

# Stalex daily source. The nightly worker writes an isolated validated snapshot
# and never publishes Stalex products to the storefront.
STALEX_DAILY_ENABLED=1
STALEX_CATALOG_URL=https://stalex.ru/upload/catalog.xml
STALEX_MODIFICATIONS_URL=https://stalex.ru/upload/modifications.xml
STALEX_POLICY_PATH=config/stalex-category-policy.json
STALEX_STATE_PATH=/var/www/7tool-shared/stalex/last-good-snapshot.json
STALEX_STATUS_PATH=/var/www/7tool-shared/stalex/refresh-status.json
STALEX_LOCK_PATH=/var/www/7tool-shared/stalex/refresh.lock
STALEX_MIN_MODIFICATIONS=800
STALEX_MIN_RETAINED_RATIO=0.9
STALEX_FETCH_ATTEMPTS=2
STALEX_FETCH_TIMEOUT_MS=120000
STALEX_CATALOG_MAX_BYTES=100663296
STALEX_MODIFICATIONS_MAX_BYTES=33554432

# Vinext production catalog pipeline. Keep this separate from every test path.
# The runner defaults to dry-run and cannot publish unless explicitly started
# with PRODUCTION_FEED_MODE=publish.
PRODUCTION_SHARED_ROOT=/var/www/7tool-production-shared
PRODUCTION_FEED_WORK_DIR=/var/www/7tool-production-shared/feed-work
PRODUCTION_CATALOG_RELEASES_DIR=/var/www/7tool-production-shared/catalog-releases
PRODUCTION_CATALOG_CURRENT_LINK=/var/www/7tool-production-shared/catalog-current
PRODUCTION_FEED_STATUS_PATH=/var/www/7tool-production-shared/refresh-status.json
PRODUCTION_FEED_LOCK_PATH=/var/www/7tool-production-shared/refresh.lock
STALEX_REVIEWED_REPORT_PATH=/var/www/7tool-production-shared/stalex/reviewed-report.json
PRODUCTION_FEED_MODE=dry-run
PRODUCTION_FEED_OFFLINE_INPUTS=0
PM2_APP_NAME=7tool-prod
PRODUCTION_STOREFRONT_HEALTH_URL=http://127.0.0.1:3108/

# Avito Autoload. Generation is dry-run by default; this does not connect to Avito.
# If AVITO_FEED_* is empty, the pipeline reuses the existing K2Tool FEED_URL/FEED_FILE.
AVITO_CONFIG=config/avito.local.json
AVITO_FEED_URL=
AVITO_FEED_FILE=
AVITO_OUTPUT_DIR=.avito
AVITO_STATE_PATH=.avito/last-good-state.json

# Yandex Wordstat. Prefer official API or an explicit export import.
YANDEX_WORDSTAT_TOKEN=
YANDEX_WORDSTAT_CLIENT_ID=

# Read-only Yandex Webmaster collection. Never expose these as NEXT_PUBLIC variables.
YANDEX_WEBMASTER_OAUTH_TOKEN=
YANDEX_WEBMASTER_USER_ID=
YANDEX_WEBMASTER_HOST_ID=

NEXT_PUBLIC_YANDEX_METRIKA_ID=109097461
YANDEX_METRIKA_OAUTH_TOKEN=

UPLOAD_DIR=
PRIVATE_UPLOAD_DIR=
BACKUP_DIR=
CRON_SECRET=
# At least 32 random characters. Signs temporary direct-download links in staff notifications.
LEAD_ATTACHMENT_LINK_SECRET=
# Defaults to 604800 seconds (7 days); accepted range is 60 seconds to 30 days.
LEAD_ATTACHMENT_LINK_TTL_SECONDS=604800

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
LEADS_TO=
LEADS_FROM=

MAX_BOT_TOKEN=
MAX_USER_ID=
MAX_CHAT_ID=
CALL_TRACKING_WEBHOOK_SECRET=
