NEXT_PUBLIC_SITE_URL=https://7tool.ru
SQLITE_PATH=
CATALOG_JSON_PATH=

# Supplier feed. Keep the authenticated URL only in the runtime secret store.
FEED_URL=
FEED_FILE=
FEED_MIN_OFFERS=5000
FEED_STATE_PATH=
FEED_LOCK_PATH=
FEED_PROVENANCE_ENABLED=0
FEED_SOURCE_ID=supplier-k2tool

# Avito Autoload. Generation is dry-run by default; this does not connect to Avito.
# If AVITO_FEED_* is empty, the pipeline reuses the existing K2Tool FEED_URL/FEED_FILE.
AVITO_CONFIG=config/avito.local.json
AVITO_FEED_URL=
AVITO_FEED_FILE=
AVITO_OUTPUT_DIR=.avito
AVITO_STATE_PATH=.avito/last-good-state.json

# Yandex Wordstat. Prefer official API or an explicit export import.
YANDEX_WORDSTAT_TOKEN=
YANDEX_WORDSTAT_CLIENT_ID=

# Read-only Yandex Webmaster collection. Never expose these as NEXT_PUBLIC variables.
YANDEX_WEBMASTER_OAUTH_TOKEN=
YANDEX_WEBMASTER_USER_ID=
YANDEX_WEBMASTER_HOST_ID=

NEXT_PUBLIC_YANDEX_METRIKA_ID=109097461
YANDEX_METRIKA_OAUTH_TOKEN=

UPLOAD_DIR=
PRIVATE_UPLOAD_DIR=
BACKUP_DIR=
CRON_SECRET=

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
LEADS_TO=
LEADS_FROM=

MAX_BOT_TOKEN=
MAX_USER_ID=
MAX_CHAT_ID=
CALL_TRACKING_WEBHOOK_SECRET=
