# Durable request workspace. Enable for the live storefront only after the
# shared data directory, access control and backup policy are configured.
QUOTE_WORKSPACE_ENABLED=0
QUOTE_DATA_DIR=

# Isolated staging compatibility. Never enable on 7tool.ru.
QUOTE_TEST_MODE=0
QUOTE_TEST_DATA_DIR=

# Enable only on the live 7tool.ru process after launch approval.
# The application additionally checks the exact request host, so test.7tool.ru stays noindex.
SEO_INDEXING_ENABLED=0

# Customer shipping promise. A valid snapshot timestamp is mandatory for today.
SHIPPING_TIME_ZONE=Europe/Moscow
SHIPPING_CUTOFF_HOUR=18
SHIPPING_WORKING_DAYS=1,2,3,4,5
SHIPPING_HOLIDAYS=
SHIPPING_TODAY_ENABLED=1
SHIPPING_FEED_MAX_AGE_MINUTES=1560
CATALOG_FEED_PATH=
CATALOG_SNAPSHOT_META_PATH=
SHIPPING_SETTINGS_PATH=
# Set only from the successful catalog snapshot pipeline, never manually.
CATALOG_SNAPSHOT_UPDATED_AT=

# Exact host allowlist for the signed local administrator session.
# Production example: 7tool.ru,www.7tool.ru. Staging example: test.7tool.ru.
MANAGER_AUTH_LOCAL_HOSTS=
# Backward-compatible staging-only alias. Keep empty on production.
MANAGER_AUTH_TEST_HOSTS=
# Server-side fallback login. Store only a PBKDF2 hash, never the plaintext password.
# Format: pbkdf2-sha256$310000$<base64url-salt>$<base64url-digest>
MANAGER_AUTH_LOCAL_USERNAME=
MANAGER_AUTH_LOCAL_PASSWORD_HASH=

# Hosted staff access uses platform-authenticated headers plus these explicit allowlists.
# Separate multiple corporate email addresses with commas. Leave empty to deny the role.
MANAGER_AUTH_ADMIN_EMAILS=
MANAGER_AUTH_MANAGER_EMAILS=
MANAGER_AUTH_APPROVER_EMAILS=
