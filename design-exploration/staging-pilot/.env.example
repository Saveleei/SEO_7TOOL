QUOTE_TEST_MODE=0
QUOTE_TEST_DATA_DIR=

# Customer shipping promise. A valid snapshot timestamp is mandatory for today.
SHIPPING_TIME_ZONE=Europe/Moscow
SHIPPING_CUTOFF_HOUR=18
SHIPPING_WORKING_DAYS=1,2,3,4,5
SHIPPING_HOLIDAYS=
SHIPPING_TODAY_ENABLED=1
SHIPPING_FEED_MAX_AGE_MINUTES=180
SHIPPING_SETTINGS_PATH=
# Set only from the successful catalog snapshot pipeline, never manually.
CATALOG_SNAPSHOT_UPDATED_AT=

# Optional exact host allowlist for the signed test-only administrator session.
# Keep empty outside a separately protected staging environment.
MANAGER_AUTH_TEST_HOSTS=
# Test-only HTML login. Store only a PBKDF2 hash, never the plaintext password.
# Format: pbkdf2-sha256$310000$<base64url-salt>$<base64url-digest>
MANAGER_AUTH_LOCAL_USERNAME=
MANAGER_AUTH_LOCAL_PASSWORD_HASH=

# Hosted staff access uses platform-authenticated headers plus these explicit allowlists.
# Separate multiple corporate email addresses with commas. Leave empty to deny the role.
MANAGER_AUTH_ADMIN_EMAILS=
MANAGER_AUTH_MANAGER_EMAILS=
MANAGER_AUTH_APPROVER_EMAILS=
