# Review-only production cutover template. Do not install without an approved
# cutover, a timestamped backup of the active server block and `nginx -t`.

server {
    listen 80;
    listen [::]:80;
    server_name 7tool.ru www.7tool.ru;
    location /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://7tool.ru$request_uri; }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.7tool.ru;

    ssl_certificate     /etc/letsencrypt/live/7tool.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/7tool.ru/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    return 301 https://7tool.ru$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name 7tool.ru;

    ssl_certificate     /etc/letsencrypt/live/7tool.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/7tool.ru/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    add_header Strict-Transport-Security "max-age=15552000" always;
    client_max_body_size 25m;
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml text/plain;

    location /.well-known/acme-challenge/ { root /var/www/html; }

    # The new request outbox posts to this legacy adapter. Keep this exact
    # endpoint on 3108 until the bridge is replaced, otherwise delivery breaks
    # or can recurse back into the new storefront.
    location = /api/lead {
        proxy_pass http://127.0.0.1:3108;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    location /_next/static/ {
        proxy_pass http://127.0.0.1:3244;
        proxy_cache_valid 200 365d;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        proxy_pass http://127.0.0.1:3244;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 60s;
    }
}
