{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "predev": "node scripts/build-catalog-presentation.mjs",
    "prebuild": "node scripts/build-catalog-presentation.mjs",
    "build": "vinext build",
    "catalog:build-presentation": "node scripts/build-catalog-presentation.mjs",
    "data:check": "node scripts/check-catalog-data.mjs",
    "seo:check": "node --test tests/technical-seo.test.mjs tests/catalog-quality-center.test.mjs tests/catalog-runtime-loading.test.mjs",
    "acceptance:business": "node scripts/run-business-acceptance.mjs",
    "intake:process": "node scripts/process-quote-intake-outbox.mjs",
    "start": "vinext start",
    "start:production": "sh scripts/start-production.sh",
    "validate:production": "node scripts/validate-production-config.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test": "node --test tests/*.test.mjs",
    "smoke:release": "node scripts/smoke-release-candidate.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "next": "16.2.6",
    "pdf-lib": "^1.17.1",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
